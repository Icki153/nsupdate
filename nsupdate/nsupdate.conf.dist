# Global configuration for nsupdate-2fa.
# Copy this file to nsupdate.conf and protect it with chmod 600.

# Required INWX credentials. These values may be overridden per record.
NSUPDATE_INWX_USER="YOUR_INWX_USER_NAME"
NSUPDATE_INWX_PASSWORD="YOUR_INWX_USER_PASSWORD"

# Optional TOTP shared secret from the INWX 2FA setup QR code.
# This is the permanent Base32 secret, not the changing six-digit code.
NSUPDATE_INWX_SHARED_SECRET="YOUR_BASE32_SHARED_SECRET"

# Optional alternative command that prints the current six-digit TOTP.
# It overrides oathtool. The configuration file is trusted shell code.
# INWX_TOTP_COMMAND="pass show inwx/totp | oathtool --totp -b -"

# Default DNS record settings.
# NSUPDATE_RECORD_TYPE="A"
# NSUPDATE_RECORD_TTL="300"

# Logging.
# VERBOSE="false"
# DEBUG="false"
# LOG_DATE_FORMAT="%Y-%m-%d %H:%M:%S"
# NSUPDATE_LOG_DIR="/var/log/nsupdate"
# NSUPDATE_LOG_FILE="nsupdate.log"

# Paths.
# BASEDIR="/usr/local/etc"
# NSUPDATE_CONF_DIR="$BASEDIR/nsupdate"
# NSUPDATE_CONFD_DIR="$NSUPDATE_CONF_DIR/conf.d"
# NSUPDATE_TMP_DIR="/tmp"
# NSUPDATE_CONF_EXTENSION=".conf"

# Network/API settings.
# NSUPDATE_IP_CHECK_SITE="https://api64.ipify.org"
# NSUPDATE_INWX_API="https://api.domrobot.com/xmlrpc/"
# NSUPDATE_INWX_NAMESERVER="ns.inwx.de"
# NSUPDATE_CURL_TIMEOUT="30"
